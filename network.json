{
    "name": "BicycleNetwork1",
    "baudrate": 19200,
    "master": "BodyComputer",
    "nodes": {
        "BodyComputer": {
            "address": "0x0",
            "subscribes": [
                "RideStatus",
                "RoadStatus",
                "RearLightStatus",
                "FrontLightStatus"
            ],
            "publishes": [
                "LightSynchronization"
            ]
        },
        "RotorSensor": {
            "address": "0x1",
            "subscribes": [
            ],
            "publishes": [
                "RideStatus",
                "RoadStatus"
            ]
        },
        "RearLight": {
            "address": "0x03",
            "subscribes": [
                "RideStatus",
                "LightSynchronization"
            ],
            "publishes": [
                "RearLightStatus"
            ]
        },
        "FrontLight": {
            "address": "0x04",
            "subscribes": [
                "LightSynchronization"
            ],
            "publishes": [
                "FrontLightStatus"
            ]
        }
    },
    "requests": {
        "RideStatus": {
            "id": "0x1000",
            "size": 10,
            "layout": {
                "Speed": {
                    "offset": 0,
                    "width": 10,
                    "initial": 0.0,
                    "encoder": "SpeedEncoder"
                },
                "SpeedState": {
                    "offset": 10,
                    "width": 2,
                    "initial": "Error",
                    "encoder": "SpeedStateEncoder"
                },
                "BrakeState": {
                    "offset": 12,
                    "width": 2,
                    "initial": "Disabled",
                    "encoder": "BrakeStateEncoder"
                },
                "RollingCode": {
                    "offset": 14,
                    "width": 2,
                    "initial": 0
                },
                "Cadence": {
                    "offset": 16,
                    "width": 8,
                    "initial": 0,
                    "encoder": "CadenceEncoder"
                },
                "CadenceState": {
                    "offset": 24,
                    "width": 2,
                    "initial": "NotAvailable",
                    "encoder": "CadenceStateEncoder"
                },
                "GearState": {
                    "offset": 26,
                    "width": 2,
                    "initial": "Unknown",
                    "encoder": "GearStateEncoder"
                },
                "EstimatedGear": {
                    "offset": 28,
                    "width": 4,
                    "initial": 0
                },
                "Duration": {
                    "offset": 32,
                    "width": 16,
                    "initial": 0
                },
                "Distance": {
                    "offset": 48,
                    "width": 20,
                    "initial": 0,
                    "encoder": "DistanceEncoder"
                },
                "DistanceState": {
                    "offset": 68,
                    "width": 2,
                    "initial": "NotAvailable",
                    "encoder": "DistanceStateEncoder"
                },
                "RideState": {
                    "offset": 70,
                    "width": 2,
                    "initial": "NotStarted",
                    "encoder": "RideStateEncoder"
                },
                "Reserved1": {
                    "offset": 72,
                    "width": 8,
                    "initial": 0
                }
            }
        },
        "RoadStatus": {
            "id": "0x1001",
            "size": 10,
            "layout": {
                "Altitude": {
                    "offset": 0,
                    "width": 12,
                    "initial": 0,
                    "encoder": "AltitudeEncoder"
                },
                "AltitudeState": {
                    "offset": 12,
                    "width": 1,
                    "initial": "Error",
                    "encoder": "GenericStateFlag"
                },
                "PressureState": {
                    "offset": 13,
                    "width": 1,
                    "initial": "Error",
                    "encoder": "GenericStateFlag"
                },
                "TemperatureState": {
                    "offset": 14,
                    "width": 1,
                    "initial": "Error",
                    "encoder": "GenericStateFlag"
                },
                "Reserved1": {
                    "offset": 15,
                    "width": 1,
                    "initial": 0
                },
                "Pressure": {
                    "offset": 16,
                    "width": 17,
                    "initial": 0
                },
                "Temperature": {
                    "offset": 33,
                    "width": 7,
                    "initial": 0,
                    "encoder": "TemperatureEncoder"
                },
                "RoadGrade": {
                    "offset": 40,
                    "width": 6,
                    "initial": 0,
                    "encoder": "RoadGradeEncoder"
                },
                "RoadQuality": {
                    "offset": 46,
                    "width": 2,
                    "initial": "NotMeasured",
                    "encoder": "RoadQualityEncoder"
                },
                "ITPMSState": {
                    "offset": 48,
                    "width": 2,
                    "initial": "Stopped",
                    "encoder": "ITPMSEncoder"
                },
                "Reserved2": {
                    "offset": 50,
                    "width": 6,
                    "initial": 0
                },
                "Reserved3": {
                    "offset": 56,
                    "width": 24,
                    "initial": 0
                }
            }
        },
        "LightSynchronization": {
            "id": "0x1040",
            "size": 10,
            "layout": {
                "TargetBrightness": {
                    "offset": 0,
                    "width": 8,
                    "initial": 0,
                    "encoder": "LightBrightnessEncoder"
                },
                "LightMode": {
                    "offset": 8,
                    "width": 2,
                    "initial": "Adaptive",
                    "encoder": "LightModeEncoder"
                },
                "TurnSignalDirection": {
                    "offset": 10,
                    "width": 2,
                    "initial": "Disabled",
                    "encoder": "TurnSignalDirectionEncoder"
                },
                "StrobeSignal": {
                    "offset": 12,
                    "width": 1,
                    "initial": "Off",
                    "encoder": "StrobeSignalEncoder"
                },
                "AntiStrobeSignal": {
                    "offset": 13,
                    "width": 1,
                    "initial": "Off",
                    "encoder": "StrobeSignalEncoder"
                },
                "RollingCode": {
                    "offset": 14,
                    "width": 2,
                    "initial": 0
                },
                "RearBehavior": {
                    "offset": 16,
                    "width": 2,
                    "initial": "Solid",
                    "encoder": "LightBehaviorEncoder"
                },
                "FrontBehavior": {
                    "offset": 18,
                    "width": 2,
                    "initial": "Solid",
                    "encoder": "LightBehaviorEncoder"
                },
                "BrakeLightMode": {
                    "offset": 20,
                    "width": 1,
                    "initial": "Default",
                    "encoder": "GenericModeSwitchEncoder"
                },
                "TurnSignalLightMode": {
                    "offset": 21,
                    "width": 1,
                    "initial": "Default",
                    "encoder": "GenericModeSwitchEncoder"
                },
                "BeamForming": {
                    "offset": 22,
                    "width": 1,
                    "initial": "Default",
                    "encoder": "GenericModeSwitchEncoder"
                },
                "HighBeam": {
                    "offset": 23,
                    "width": 1,
                    "initial": "Off",
                    "encoder": "GenericSwitchEncoder"
                },
                "Reserved1": {
                    "offset": 24,
                    "width": 24,
                    "initial": 0
                },
                "Reserved2": {
                    "offset": 48,
                    "width": 32,
                    "initial": 0
                }
            }
        },
        "RearLightStatus": {
            "id": "0x1051",
            "size": 10,
            "layout": {
                "TailLightState": {
                    "offset": 0,
                    "width": 2,
                    "initial": "Off",
                    "encoder": "LightStateEncoder"
                },
                "BrakeLightState": {
                    "offset": 2,
                    "width": 2,
                    "initial": "Off",
                    "encoder": "LightStateEncoder"
                },
                "TurnSignalState": {
                    "offset": 4,
                    "width": 2,
                    "initial": "Off",
                    "encoder": "LightStateEncoder"
                },
                "ThermalState": {
                    "offset": 6,
                    "width": 2,
                    "initial": "NotMeasured",
                    "encoder": "ThermalStateEncoder"
                },
                "DriveTemperature": {
                    "offset": 8,
                    "width": 7,
                    "initial": 0,
                    "encoder": "TemperatureEncoder"
                },
                "McuTemperature": {
                    "offset": 15,
                    "width": 7,
                    "initial": 0,
                    "encoder": "TemperatureEncoder"
                },
                "RollingCode": {
                    "offset": 22,
                    "width": 2,
                    "initial": 0
                },
                "Reserved1": {
                    "offset": 24,
                    "width": 24,
                    "initial": 0
                },
                "Reserved2": {
                    "offset": 48,
                    "width": 32,
                    "initial": 0
                }
            }
        },
        "FrontLightStatus": {
            "id": "0x1061",
            "size": 10,
            "layout": {
                "MainLightState": {
                    "offset": 0,
                    "width": 2,
                    "initial": "Off",
                    "encoder": "LightStateEncoder"
                },
                "HighBeamState": {
                    "offset": 2,
                    "width": 2,
                    "initial": "Off",
                    "encoder": "LightStateEncoder"
                },
                "TurnSignalState": {
                    "offset": 4,
                    "width": 2,
                    "initial": "Off",
                    "encoder": "LightStateEncoder"
                },
                "ThermalState": {
                    "offset": 6,
                    "width": 2,
                    "initial": "NotMeasured",
                    "encoder": "ThermalStateEncoder"
                },
                "DriveTemperature": {
                    "offset": 8,
                    "width": 7,
                    "initial": 0,
                    "encoder": "TemperatureEncoder"
                },
                "McuTemperature": {
                    "offset": 15,
                    "width": 7,
                    "initial": 0,
                    "encoder": "TemperatureEncoder"
                },
                "RollingCode": {
                    "offset": 22,
                    "width": 2,
                    "initial": 0
                },
                "ModeSwitchRequested": {
                    "offset": 24,
                    "width": 1,
                    "initial": "NotRequested",
                    "encoder": "GenericRequestEncoder"
                },
                "ModeSwitchCycles": {
                    "offset": 25,
                    "width": 3,
                    "initial": 0
                },
                "Reserved1": {
                    "offset": 28,
                    "width": 4,
                    "initial": 0
                },
                "Reserved2": {
                    "offset": 32,
                    "width": 32,
                    "initial": 0
                },
                "Reserved3": {
                    "offset": 64,
                    "width": 16,
                    "initial": 0
                }
            }
        }
    },
    "encoders": {
        "SpeedEncoder": {
            "type": "formula",
            "scale": 0.1,
            "offset": 0.0,
            "unit": "km/h"
        },
        "SpeedStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Ok",
                "1": "SlowResponse",
                "2": "Unreliable",
                "3": "Error"
            }
        },
        "BrakeStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Disabled",
                "1": "NotBraking",
                "2": "Braking",
                "3": "UNUSED"
            }
        },
        "CadenceEncoder": {
            "type": "formula",
            "scale": 1,
            "offset": 0,
            "unit": "rpm"
        },
        "CadenceStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "NotAvailable",
                "1": "Ok",
                "2": "Coasting",
                "3": "Error"
            }
        },
        "GearStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Unknown",
                "1": "Ok",
                "2": "OutOfRange",
                "3": "Error"
            }
        },
        "TimeDurationEncoder": {
            "type": "formula",
            "scale": 1,
            "offset": 0,
            "unit": "sec"
        },
        "DistanceEncoder": {
            "type": "formula",
            "scale": 1,
            "offset": 0,
            "unit": "m"
        },
        "DistanceStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "NotAvailable",
                "1": "Ok",
                "2": "Error",
                "3": "PermanentError"
            }
        },
        "RideStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "NotStarted",
                "1": "Active",
                "2": "Idle",
                "3": "Paused"
            }
        },
        "AltitudeEncoder": {
            "type": "formula",
            "scale": 1,
            "offset": -500,
            "unit": "m"
        },
        "RoadGradeEncoder": {
            "type": "formula",
            "scale": 1,
            "offset": -31,
            "unit": "%"
        },
        "RoadQualityEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "NotMeasured",
                "1": "Flat",
                "2": "Rough",
                "3": "VeryRough"
            }
        },
        "ITPMSEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Stopped",
                "1": "Running",
                "2": "FrontPressureLow",
                "3": "RearPressureLow"
            }
        },
        "GenericStateFlag": {
            "type": "mapping",
            "mapping": {
                "0": "Ok",
                "1": "Error"
            }
        },
        "GenericSwitchEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Off",
                "1": "On"
            }
        },
        "GenericModeSwitchEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Default",
                "1": "Off"
            }
        },
        "GenericRequestEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "NotRequested",
                "1": "Requested"
            }
        },
        "TemperatureEncoder": {
            "type": "formula",
            "scale": 1,
            "offset": -20,
            "unit": "°C"
        },
        "LightBrightnessEncoder": {
            "type": "formula",
            "scale": 1,
            "offset": 0
        },
        "LightModeEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Adaptive",
                "1": "DLR",
                "2": "Emergency",
                "3": "Off"
            }
        },
        "TurnSignalDirectionEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Disabled",
                "1": "Right",
                "2": "Left",
                "3": "Hazard"
            }
        },
        "StrobeSignalEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "On",
                "1": "Off"
            }
        },
        "LightBehaviorEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Solid",
                "1": "Blink",
                "2": "Pulse",
                "3": "Dynamic"
            }
        },
        "LightStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "Off",
                "1": "Ok",
                "2": "PartialError",
                "3": "Error"
            }
        },
        "ThermalStateEncoder": {
            "type": "mapping",
            "mapping": {
                "0": "NotMeasured",
                "1": "Ok",
                "2": "Derating",
                "3": "Shutdown"
            }
        }
    },
    "schedules": {
        "NormalSchedule": {
            "type": "priority-aging",
            "slots": "variable",
            "delay": 0.05,
            "phase": "adjusted",
            "entries": [
                {"type": "request", "request": "RideStatus", "cycle": 0, "maxAge": 2},
                {"type": "request", "request": "LightSynchronization", "cycle": 1, "maxAge": 3},
                {"type": "request", "request": "FrontLightStatus", "cycle": 2, "maxAge": 15},
                {"type": "request", "request": "RearLightStatus", "cycle": 2, "maxAge": 15},
                {"type": "request", "request": "RoadStatus", "cycle": 5, "maxAge": 15}
            ]
        },
        "MinimalSchedule": {
            "type": "fixed",
            "delay": 0.1,
            "entries": [
                {"type": "request", "request": "RideStatus"},
                {"type": "request", "request": "LightSynchronization"}
            ]
        },
        "RotorSensorSchedule": {
            "type": "fixed",
            "slots": "variable",
            "delay": 0.05,
            "entries": [
                {"type": "request", "request": "RideStatus"},
                {"type": "request", "request": "RoadStatus"}
            ]
        },
        "LightSchedule": {
            "type": "fixed",
            "slots": "variable",
            "delay": 0.05,
            "entries": [
                {"type": "request", "request": "LightSynchronization"},
                {"type": "request", "request": "RearLightStatus"},
                {"type": "request", "request": "FrontLightStatus"}
            ]
        },
        "RearLightSchedule": {
            "type": "fixed",
            "slots": "variable",
            "delay": 0.05,
            "entries": [
                {"type": "request", "request": "LightSynchronization"},
                {"type": "request", "request": "RearLightStatus"},
                {"type": "opstatus", "node": "RearLight"},
                {"type": "pwrstatus", "node": "RearLight"},
                {"type": "serial", "node": "RearLight"},
                {"type": "swversion", "node": "RearLight"}
            ]
        },
        "FrontLightSchedule": {
            "type": "fixed",
            "slots": "variable",
            "delay": 0.05,
            "entries": [
                {"type": "request", "request": "LightSynchronization"},
                {"type": "request", "request": "FrontLightStatus"},
                {"type": "opstatus", "node": "FrontLight"},
                {"type": "pwrstatus", "node": "FrontLight"},
                {"type": "serial", "node": "FrontLight"},
                {"type": "swversion", "node": "FrontLight"}
            ]
        }
    }
}
