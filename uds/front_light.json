{
    "types": {
        "StrobeMode": {
            "type": "enum",
            "values": [
                "DISABLED",
                "INTERNAL_SINGLE",
                "INTERNAL_RAPID",
                "EXTERNAL_POS",
                "EXTERNAL_NEG"
            ]
        },
        "Segment": {
            "type": "enum",
            "values": [
                "MAIN"
            ]
        },
        "AdcChannel": {
            "type": "enum",
            "values": [
                "McuTemperature",
                "DriveTemperature",
                "Reserved1",
                "Reserved2",
                "BatteryVoltage",
                "MainDriverVoltage",
                "Reserved3",
                "Reserved4"
            ]
        },
        "DriverFault": {
            "type": "enum",
            "values": [
                "NoError",
                "OverTemperature",
                "OpenLoad",
                "ShortToGround",
                "ShortToVcc"
            ]
        },
        "DriverStatus": {
            "type": "struct",
            "fields": {
                "MainLightStatus": {
                    "type": "DriverFault"
                }
            }
        },
        "ButtonStatus": {
            "type": "struct",
            "fields": {
                "Pressed": {
                    "type": "bool"
                },
                "CycleCount": {
                    "type": "uint8_t"
                }
            }
        }
    },
    "services": {
        "Config_Reload": {
            "id": "0x4000",
            "description": "Updates the configuration with the latest UDS property values",
            "group": "Configuration",
            "params": {},
            "return": "void"
        },
        "Config_Save": {
            "id": "0x4001",
            "description": "Saves the current UDS property values to EEPROM",
            "group": "Configuration",
            "params": {},
            "return": "void"
        },
        "Calib_Voltage": {
            "id": "0x4003",
            "description": "Changes the voltage calibration values for battery voltage readings",
            "group": "Calibration",
            "params": {
                "Slope": {
                    "type": "uint16_t"
                },
                "Offset": {
                    "type": "int16_t"
                }
            },
            "return": "void"
        },
        "Calib_Save": {
            "id": "0x4004",
            "description": "Saves the current calibration values to EEPROM",
            "group": "Calibration",
            "params": {},
            "return": "void"
        },
        "Driver_Control": {
            "id": "0x4010",
            "description": "Tests each segment of the light",
            "group": "Driver",
            "params": {
                "Segment": {
                    "type": "Segment"
                },
                "Mode": {
                    "type": "uint8_t"
                },
                "Brightness": {
                    "type": "uint16_t"
                }
            },
            "return": "void"
        },
        "Driver_Status": {
            "id": "0x4011",
            "description": "Returns the current status of the LED driver",
            "group": "Driver",
            "params": {},
            "return": "DriverStatus"
        },
        "Adc_Read": {
            "id": "0x4020",
            "description": "Reads the value of an ADC channel",
            "group": "IO",
            "params": {
                "Channel": {
                    "type": "AdcChannel"
                }
            },
            "return": "uint16_t"
        },
        "Button_Status": {
            "id": "0x4030",
            "description": "Returns the current status of the button",
            "group": "IO",
            "params": {},
            "return": "ButtonStatus"
        },
        "Button_Control": {
            "id": "0x4031",
            "description": "Controls the button",
            "group": "IO",
            "params": {
                "Press": {
                    "type": "bool"
                },
                "CycleCount": {
                    "type": "uint8_t"
                }
            },
            "return": "void"
        }
    },
    "properties": {
