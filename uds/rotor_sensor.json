{
    "types": {
        "SpeedSensorType": {
            "type": "enum",
            "values": [
                "TLE5045"
            ]
        },
        "AdcChannel": {
            "type": "enum",
            "values": [
                "McuTemperature",
                "Reserved1",
                "FrontSensor",
                "RearSensor",
                "BatteryVoltage",
                "Reserved2",
                "CrankSensor",
                "Reserved3"
            ]
        },
        "PressureData": {
            "type": "struct",
            "fields": {
                "ErrorCode": {
                    "type": "uint8_t"
                },
                "Pressure": {
                    "type": "uint32_t"
                },
                "Temperature": {
                    "type": "int8_t"
                }
            }
        },
        "ImuData": {
            "type": "struct",
            "fields": {
                "ErrorCode": {
                    "type": "uint8_t"
                },
                "AccelX": {
                    "type": "int16_t"
                },
                "AccelY": {
                    "type": "int16_t"
                },
                "AccelZ": {
                    "type": "int16_t"
                },
                "GyroX": {
                    "type": "int16_t"
                },
                "GyroY": {
                    "type": "int16_t"
                },
                "GyroZ": {
                    "type": "int16_t"
                }
            }
        },
        "RideRecord": {
            "type": "struct",
            "fields": {
                "Identifier": {
                    "type": "uint16_t"
                },
                "Duration": {
                    "type": "uint16_t"
                },
                "Distance": {
                    "type": "uint32_t"
                },
                "CrankRevolutions": {
                    "type": "uint16_t"
                },
                "TopSpeed": {
                    "type": "uint16_t"
                },
                "AvgSpeed": {
                    "type": "uint16_t"
                },
                "Elevation": {
                    "type": "uint16_t"
                },
                "Descent": {
                    "type": "uint16_t"
                },
                "Flags": {
                    "type": "uint16_t"
                }
            }
        }
    },
    "services": {
        "Config_Reload": {
            "id": "0x1000",
